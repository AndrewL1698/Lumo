{
  "manifest_version": 3,
  "name": "Luci",
  "version": "0.0.1",
  "description": "Lights up English words in Spanish on sites you choose, so you learn while you read.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeContent"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Luci",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-parrot": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle Luci"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
