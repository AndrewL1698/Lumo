{
  "manifest_version": 3,
  "name": "Parrot",
  "version": "0.0.1",
  "description": "Swaps English words into Spanish on sites you choose.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Parrot"
  },
  "commands": {
    "toggle-parrot": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Toggle Parrot"
    }
  }
}
